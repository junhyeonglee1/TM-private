# User data and recovery artifacts live outside source control.
/data/
/backups/
/exports/

# Build outputs and packaged executables are reproducible artifacts.
/dist/
/tm.exe

# Secrets must be injected by the local process or a cloud secret manager.
.env
.env.*
!.env.example
/secrets/

# Local editor and OS metadata.
/.idea/
/.vscode/
Thumbs.db
Desktop.ini
