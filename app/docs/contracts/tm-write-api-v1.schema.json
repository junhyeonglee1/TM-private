{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tm.local/schemas/tm-write-api-v1.schema.json",
  "title": "TM controlled write API v1 bodies and responses",
  "anyOf": [
    { "$ref": "#/$defs/ProjectCreateRequest" },
    { "$ref": "#/$defs/TaskCreateRequest" },
    { "$ref": "#/$defs/TaskUpdateRequest" },
    { "$ref": "#/$defs/NoteCreateRequest" },
    { "$ref": "#/$defs/NoteUpdateRequest" },
    { "$ref": "#/$defs/ChecklistSetDoneRequest" },
    { "$ref": "#/$defs/MutationResponse" }
  ],
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Date": { "type": "string", "format": "date" },
    "NullableDate": { "type": ["string", "null"], "format": "date" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "NullableTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "NullableString": { "type": ["string", "null"] },
    "NullableUuid": {
      "oneOf": [
        { "$ref": "#/$defs/Uuid" },
        { "type": "null" }
      ]
    },
    "TaskStatus": {
      "enum": ["inbox", "todo", "in_progress", "blocked", "done", "cancelled"]
    },
    "NoteType": {
      "enum": ["concept", "howto", "decision", "reference", "daily"]
    },
    "ProjectCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 20000 },
        "color": {
          "oneOf": [
            { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "TaskCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "projectId": { "$ref": "#/$defs/NullableUuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 20000 },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "dueDate": { "$ref": "#/$defs/NullableDate" }
      }
    },
    "TaskUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 20000 },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "clearProject": { "type": "boolean" },
        "dueDate": { "$ref": "#/$defs/Date" },
        "clearDueDate": { "type": "boolean" }
      }
    },
    "NoteCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteType", "title"],
      "properties": {
        "noteType": { "$ref": "#/$defs/NoteType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "body": { "type": "string", "maxLength": 50000 },
        "noteDate": { "$ref": "#/$defs/NullableDate" }
      }
    },
    "NoteUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "noteType": { "$ref": "#/$defs/NoteType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "body": { "type": "string", "maxLength": 50000 },
        "noteDate": { "$ref": "#/$defs/Date" },
        "clearNoteDate": { "type": "boolean" }
      }
    },
    "ChecklistSetDoneRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isDone"],
      "properties": {
        "isDone": { "type": "boolean" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "projectId", "title", "description", "status", "priority",
        "dueDate", "completedAt", "createdAt", "updatedAt", "version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "projectId": { "$ref": "#/$defs/NullableUuid" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "dueDate": { "$ref": "#/$defs/NullableDate" },
        "completedAt": { "$ref": "#/$defs/NullableTimestamp" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "color", "sortOrder",
        "createdAt", "updatedAt", "archivedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "$ref": "#/$defs/NullableString" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "archivedAt": { "$ref": "#/$defs/NullableTimestamp" }
      }
    },
    "Note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "noteType", "title", "body", "sourceWorklogId", "noteDate",
        "createdAt", "updatedAt", "version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "noteType": { "$ref": "#/$defs/NoteType" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "sourceWorklogId": { "$ref": "#/$defs/NullableUuid" },
        "noteDate": { "$ref": "#/$defs/NullableDate" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "ChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "taskId", "body", "isDone", "sortOrder", "createdAt",
        "updatedAt", "completedAt", "version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "taskId": { "$ref": "#/$defs/Uuid" },
        "body": { "type": "string" },
        "isDone": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "completedAt": { "$ref": "#/$defs/NullableTimestamp" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "MutationData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "resourceType", "resourceId", "version", "replayed", "item"
      ],
      "properties": {
        "operation": {
          "enum": [
            "project_create", "task_create", "task_update", "note_create",
            "note_update", "checklist_set_done"
          ]
        },
        "resourceType": { "enum": ["project", "task", "note", "checklist"] },
        "resourceId": { "$ref": "#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "replayed": { "type": "boolean" },
        "item": {
          "oneOf": [
            { "$ref": "#/$defs/Project" },
            { "$ref": "#/$defs/Task" },
            { "$ref": "#/$defs/Note" },
            { "$ref": "#/$defs/ChecklistItem" }
          ]
        }
      }
    },
    "MutationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "data"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "data": { "$ref": "#/$defs/MutationData" }
      }
    }
  }
}
